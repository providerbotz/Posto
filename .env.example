# ==============================================================================
# POSTO - Telegram Channel Post Maker Bot Configuration
# ==============================================================================

# Telegram Bot Credentials (Get from @BotFather on Telegram)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567

# Telegram API Credentials (Get from https://my.telegram.org)
API_ID=12345678
API_HASH=0123456789abcdef0123456789abcdef

# MongoDB Database Configuration (Async Motor Connection)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
DATABASE_NAME=posto

# Bot Owner Telegram User ID (Used for owner-only commands and notifications)
OWNER_ID=123456789

# Web Server Network Binding
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Public Base URL of the Web Panel (Used for Telegram WebApp and tokenized links)
# e.g. https://my-posto-app.koyeb.app or https://posto-bot.onrender.com
BASE_URL=https://my-posto-app.example.com

# Start Welcome Banner Image (Relative path or public image URL)
START_IMAGE=start_image.jpg

# Optional Telegram Log Channel ID for activity, publishing, and error monitoring
LOG_CHANNEL_ID=-1001234567890

# Cryptographic Secret for Signing Web Panel Authentication Tokens (Min 32 characters)
SESSION_SECRET=replace_with_a_secure_random_hex_string_32_chars_or_more
